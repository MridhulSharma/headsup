# Copy to .env and fill in. Never commit .env.

# Anthropic API key. Set a hard spend limit in the Console.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# mock | ollama | claude  — unit tests must run with mock (no API spend).
HU_LLM_MODE=mock

# Ed25519 signing key for advisories (base64 32-byte seed). Generate one with
# `uv run hu keygen --show-private`; never share or commit it. With this unset,
# `hu compile` falls back to the published development key and says so.
HU_SIGNING_KEY=base64-encoded-ed25519-seed

# Public half, for a process that verifies but never signs. Optional: a holder
# of HU_SIGNING_KEY derives it.
HU_VERIFY_KEY=base64-encoded-ed25519-public-key

# Who the advisories say issued them: headsup/<city>. Defaults to
# headsup/san_antonio, the S1 scenario. HU_CITY=austin is the other city.
HU_ISSUER=headsup/san_antonio

# Redis ACL users (see `hu bus acl apply`). Only the compiler may XADD to the
# advisories stream; agents connect as `agent`, which may read and consume that
# stream but gets NOPERM on XADD, XDEL and XTRIM. The users are saved to the
# aclfile in docker-compose.yml, so they survive a restart. With these unset,
# every process connects as the open `default` user instead.
HU_REDIS_COMPILER_PASSWORD=compiler-dev
HU_REDIS_AGENT_PASSWORD=agent-dev

# Sent to every public feed. NWS asks for a contact address and turns away
# anonymous clients. Optional: a descriptive default is used when unset.
HU_HTTP_USER_AGENT=headsup-research/0.1 (your-name; you@example.com)

# Where `hu world build` keeps built road graphs, POIs and raw Overpass
# responses. Defaults to data/cache. Point it elsewhere on a machine that
# should not see this one's builds.
HU_WORLD_CACHE=data/cache

# An Overpass instance to use instead of the public default, as a base URL
# with no /interpreter. The default is volunteer-funded and queues, which is
# most of a cold build's wall time; `hu world build --offline` avoids it
# entirely by rebuilding from the saved responses.
HU_OVERPASS_URL=https://overpass-api.de/api

# Infra, matching docker-compose.yml.
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://headsup:headsup@localhost:5432/headsup

# Cesium ion Community token for the God's Eye View fork (also gev/.env).
CESIUM_ION_TOKEN=your-cesium-ion-token
