{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://headsup.local/schemas/advisory_properties.schema.json",
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "One thing a fleet is asked to do inside the advisory geometry.",
      "properties": {
        "type": {
          "$ref": "#/$defs/ActionType"
        },
        "applies_to": {
          "$ref": "#/$defs/AppliesTo"
        },
        "params": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,31}$": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActionType": {
      "description": "What an advisory asks a fleet to do. The playbook limits this per class.",
      "enum": [
        "NO_ENTRY",
        "SPEED_CAP",
        "ALL_WAY_STOP",
        "DENSITY_CAP",
        "KEEP_CLEAR",
        "PAUSE_SERVICE"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "AppliesTo": {
      "additionalProperties": false,
      "description": "Who an action binds, and optionally which graph elements it masks.",
      "properties": {
        "operators": {
          "items": {
            "pattern": "^(\\*|[a-z0-9_]{1,32})$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Operators",
          "type": "array"
        },
        "vehicle_classes": {
          "items": {
            "pattern": "^(\\*|[a-z0-9_]{1,32})$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Vehicle Classes",
          "type": "array"
        },
        "edges": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:\\-]+$",
            "type": "string"
          },
          "title": "Edges",
          "type": "array"
        },
        "nodes": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:\\-]+$",
            "type": "string"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "title": "AppliesTo",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A citation: which observation supports a hazard or an advisory.",
      "properties": {
        "event_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:\\-]+$",
          "title": "Event Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "kind": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.\\-]*$",
          "title": "Kind",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "raw_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Raw Ref",
          "type": "string"
        },
        "geometry": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "LineString": "#/$defs/LineString",
                  "MultiLineString": "#/$defs/MultiLineString",
                  "MultiPoint": "#/$defs/MultiPoint",
                  "MultiPolygon": "#/$defs/MultiPolygon",
                  "Point": "#/$defs/Point",
                  "Polygon": "#/$defs/Polygon"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Point"
                },
                {
                  "$ref": "#/$defs/MultiPoint"
                },
                {
                  "$ref": "#/$defs/LineString"
                },
                {
                  "$ref": "#/$defs/MultiLineString"
                },
                {
                  "$ref": "#/$defs/Polygon"
                },
                {
                  "$ref": "#/$defs/MultiPolygon"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geometry"
        }
      },
      "required": [
        "event_id",
        "source",
        "kind",
        "observed_at",
        "raw_ref"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GeometryNarrowing": {
      "additionalProperties": false,
      "description": "Why a fused hazard's area is, or is not, narrower than its feeds' own.\n\nA sentinel publishes the area a feed drew. Fusion may cut that down to the\npart its corroborating observations actually cover - an NWS flood warning\npolygon clipped to the reach of the gauges above their action stage under\nit. Either way the decision is recorded here and travels with the hazard,\nso an audit record carries both the geometry the feed published and the\ngeometry a fleet was told about, and the reason they differ or do not.\n\nNever a widening: `area_km2` is always at or below `original_area_km2`.",
      "properties": {
        "narrowed": {
          "title": "Narrowed",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "original_geometry": {
          "discriminator": {
            "mapping": {
              "LineString": "#/$defs/LineString",
              "MultiLineString": "#/$defs/MultiLineString",
              "MultiPoint": "#/$defs/MultiPoint",
              "MultiPolygon": "#/$defs/MultiPolygon",
              "Point": "#/$defs/Point",
              "Polygon": "#/$defs/Polygon"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "$ref": "#/$defs/MultiPoint"
            },
            {
              "$ref": "#/$defs/LineString"
            },
            {
              "$ref": "#/$defs/MultiLineString"
            },
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "$ref": "#/$defs/MultiPolygon"
            }
          ],
          "title": "Original Geometry"
        },
        "original_area_km2": {
          "minimum": 0.0,
          "title": "Original Area Km2",
          "type": "number"
        },
        "area_km2": {
          "minimum": 0.0,
          "title": "Area Km2",
          "type": "number"
        },
        "reach_radius_m": {
          "minimum": 0.0,
          "title": "Reach Radius M",
          "type": "number"
        },
        "corroborated_by": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:\\-]+$",
            "type": "string"
          },
          "title": "Corroborated By",
          "type": "array"
        },
        "excluded": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:\\-]+$",
            "type": "string"
          },
          "title": "Excluded",
          "type": "array"
        }
      },
      "required": [
        "narrowed",
        "reason",
        "original_geometry",
        "original_area_km2",
        "area_km2",
        "reach_radius_m"
      ],
      "title": "GeometryNarrowing",
      "type": "object"
    },
    "Hazard": {
      "additionalProperties": false,
      "description": "A fused hazard: what Heads Up believes, with every citation attached.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:\\-]+$",
          "title": "Id",
          "type": "string"
        },
        "class": {
          "$ref": "#/$defs/HazardClass"
        },
        "severity": {
          "maximum": 5,
          "minimum": 1,
          "title": "Severity",
          "type": "integer"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "geometry": {
          "discriminator": {
            "mapping": {
              "LineString": "#/$defs/LineString",
              "MultiLineString": "#/$defs/MultiLineString",
              "MultiPoint": "#/$defs/MultiPoint",
              "MultiPolygon": "#/$defs/MultiPolygon",
              "Point": "#/$defs/Point",
              "Polygon": "#/$defs/Polygon"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "$ref": "#/$defs/MultiPoint"
            },
            {
              "$ref": "#/$defs/LineString"
            },
            {
              "$ref": "#/$defs/MultiLineString"
            },
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "$ref": "#/$defs/MultiPolygon"
            }
          ],
          "title": "Geometry"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "candidates": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:\\-]+$",
            "type": "string"
          },
          "title": "Candidates",
          "type": "array"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "narrowing": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeometryNarrowing"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "class",
        "severity",
        "confidence",
        "geometry",
        "evidence",
        "valid_until"
      ],
      "title": "Hazard",
      "type": "object"
    },
    "HazardClass": {
      "description": "What kind of hazard a fused observation describes.",
      "enum": [
        "FLOOD",
        "WORK_ZONE",
        "SIGNAL_OUTAGE",
        "EMERGENCY_SCENE",
        "SCHOOL_ZONE",
        "SEVERE_WEATHER"
      ],
      "title": "HazardClass",
      "type": "string"
    },
    "LineString": {
      "additionalProperties": false,
      "description": "A road segment or a keep-clear corridor centre line.",
      "properties": {
        "type": {
          "const": "LineString",
          "default": "LineString",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "LineString",
      "type": "object"
    },
    "MultiLineString": {
      "additionalProperties": false,
      "description": "Several road segments, e.g. every approach to one intersection.",
      "properties": {
        "type": {
          "const": "MultiLineString",
          "default": "MultiLineString",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 2,
              "type": "array"
            },
            "minItems": 2,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiLineString",
      "type": "object"
    },
    "MultiPoint": {
      "additionalProperties": false,
      "description": "Several locations, e.g. the dark signals in one outage region.",
      "properties": {
        "type": {
          "const": "MultiPoint",
          "default": "MultiPoint",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPoint",
      "type": "object"
    },
    "MultiPolygon": {
      "additionalProperties": false,
      "description": "Several areas, e.g. two low-water crossings under one warning.",
      "properties": {
        "type": {
          "const": "MultiPolygon",
          "default": "MultiPolygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 2,
                "type": "array"
              },
              "minItems": 4,
              "type": "array"
            },
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPolygon",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "description": "A single location, e.g. a stream gauge or a stalled vehicle.",
      "properties": {
        "type": {
          "const": "Point",
          "default": "Point",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Point",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "description": "An area: the first ring is the exterior, the rest are holes.",
      "properties": {
        "type": {
          "const": "Polygon",
          "default": "Polygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 2,
              "type": "array"
            },
            "minItems": 4,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    },
    "Source": {
      "description": "A public feed Heads Up ingests. Values double as `events.<source>` names.",
      "enum": [
        "nws",
        "usgs",
        "wzdx",
        "austin_incidents",
        "austin_signals",
        "bexar",
        "city_dispatch",
        "synthetic"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The advisory contract, carried in the Feature's `properties`.",
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:\\-]+$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "hazard": {
      "$ref": "#/$defs/Hazard"
    },
    "action": {
      "$ref": "#/$defs/Action"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "policy_rule": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:\\-]+$",
      "title": "Policy Rule",
      "type": "string"
    },
    "issuer": {
      "pattern": "^headsup/[a-z0-9_\\-]{2,40}$",
      "title": "Issuer",
      "type": "string"
    },
    "signature": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature"
    }
  },
  "required": [
    "id",
    "hazard",
    "action",
    "valid_from",
    "valid_until",
    "evidence",
    "policy_rule",
    "issuer"
  ],
  "title": "AdvisoryProperties",
  "type": "object"
}
