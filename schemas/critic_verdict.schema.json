{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://headsup.local/schemas/critic_verdict.schema.json",
  "$defs": {
    "LineString": {
      "additionalProperties": false,
      "description": "A road segment or a keep-clear corridor centre line.",
      "properties": {
        "type": {
          "const": "LineString",
          "default": "LineString",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "LineString",
      "type": "object"
    },
    "MultiLineString": {
      "additionalProperties": false,
      "description": "Several road segments, e.g. every approach to one intersection.",
      "properties": {
        "type": {
          "const": "MultiLineString",
          "default": "MultiLineString",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 2,
              "type": "array"
            },
            "minItems": 2,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiLineString",
      "type": "object"
    },
    "MultiPoint": {
      "additionalProperties": false,
      "description": "Several locations, e.g. the dark signals in one outage region.",
      "properties": {
        "type": {
          "const": "MultiPoint",
          "default": "MultiPoint",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPoint",
      "type": "object"
    },
    "MultiPolygon": {
      "additionalProperties": false,
      "description": "Several areas, e.g. two low-water crossings under one warning.",
      "properties": {
        "type": {
          "const": "MultiPolygon",
          "default": "MultiPolygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 2,
                "type": "array"
              },
              "minItems": 4,
              "type": "array"
            },
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPolygon",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "description": "A single location, e.g. a stream gauge or a stalled vehicle.",
      "properties": {
        "type": {
          "const": "Point",
          "default": "Point",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Point",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "description": "An area: the first ring is the exterior, the rest are holes.",
      "properties": {
        "type": {
          "const": "Polygon",
          "default": "Polygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 2,
              "type": "array"
            },
            "minItems": 4,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    },
    "Verdict": {
      "description": "The critic's answer on one proposed advisory.",
      "enum": [
        "APPROVE",
        "REVISE",
        "ESCALATE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The critic's independent read of one proposal, with its reasons.",
  "properties": {
    "proposal_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:\\-]+$",
      "title": "Proposal Id",
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "reasons": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Reasons",
      "type": "array"
    },
    "revised_geometry": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "LineString": "#/$defs/LineString",
              "MultiLineString": "#/$defs/MultiLineString",
              "MultiPoint": "#/$defs/MultiPoint",
              "MultiPolygon": "#/$defs/MultiPolygon",
              "Point": "#/$defs/Point",
              "Polygon": "#/$defs/Polygon"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "$ref": "#/$defs/MultiPoint"
            },
            {
              "$ref": "#/$defs/LineString"
            },
            {
              "$ref": "#/$defs/MultiLineString"
            },
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "$ref": "#/$defs/MultiPolygon"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revised Geometry"
    },
    "revised_valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revised Valid Until"
    },
    "reviewed_by": {
      "default": "critic",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:\\-]+$",
      "title": "Reviewed By",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "proposal_id",
    "verdict",
    "reasons"
  ],
  "title": "CriticVerdict",
  "type": "object"
}
