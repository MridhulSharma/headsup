{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://headsup.local/schemas/civic_event.schema.json",
  "$defs": {
    "LineString": {
      "additionalProperties": false,
      "description": "A road segment or a keep-clear corridor centre line.",
      "properties": {
        "type": {
          "const": "LineString",
          "default": "LineString",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "LineString",
      "type": "object"
    },
    "MultiLineString": {
      "additionalProperties": false,
      "description": "Several road segments, e.g. every approach to one intersection.",
      "properties": {
        "type": {
          "const": "MultiLineString",
          "default": "MultiLineString",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 2,
              "type": "array"
            },
            "minItems": 2,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiLineString",
      "type": "object"
    },
    "MultiPoint": {
      "additionalProperties": false,
      "description": "Several locations, e.g. the dark signals in one outage region.",
      "properties": {
        "type": {
          "const": "MultiPoint",
          "default": "MultiPoint",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPoint",
      "type": "object"
    },
    "MultiPolygon": {
      "additionalProperties": false,
      "description": "Several areas, e.g. two low-water crossings under one warning.",
      "properties": {
        "type": {
          "const": "MultiPolygon",
          "default": "MultiPolygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 2,
                "type": "array"
              },
              "minItems": 4,
              "type": "array"
            },
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPolygon",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "description": "A single location, e.g. a stream gauge or a stalled vehicle.",
      "properties": {
        "type": {
          "const": "Point",
          "default": "Point",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Point",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "description": "An area: the first ring is the exterior, the rest are holes.",
      "properties": {
        "type": {
          "const": "Polygon",
          "default": "Polygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 2,
              "type": "array"
            },
            "minItems": 4,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    },
    "Source": {
      "description": "A public feed Heads Up ingests. Values double as `events.<source>` names.",
      "enum": [
        "nws",
        "usgs",
        "wzdx",
        "austin_incidents",
        "austin_signals",
        "bexar",
        "city_dispatch",
        "synthetic"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One observation from one public feed, as ingested.\n\nEverything a feed says in prose stays inside `payload`: it is data for the\nsentinels to read, never text that reaches an instruction slot.",
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:\\-]+$",
      "title": "Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "kind": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.\\-]*$",
      "title": "Kind",
      "type": "string"
    },
    "geometry": {
      "discriminator": {
        "mapping": {
          "LineString": "#/$defs/LineString",
          "MultiLineString": "#/$defs/MultiLineString",
          "MultiPoint": "#/$defs/MultiPoint",
          "MultiPolygon": "#/$defs/MultiPolygon",
          "Point": "#/$defs/Point",
          "Polygon": "#/$defs/Polygon"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Point"
        },
        {
          "$ref": "#/$defs/MultiPoint"
        },
        {
          "$ref": "#/$defs/LineString"
        },
        {
          "$ref": "#/$defs/MultiLineString"
        },
        {
          "$ref": "#/$defs/Polygon"
        },
        {
          "$ref": "#/$defs/MultiPolygon"
        }
      ],
      "title": "Geometry"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "raw_ref": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Raw Ref",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    }
  },
  "required": [
    "source",
    "kind",
    "geometry",
    "observed_at",
    "raw_ref"
  ],
  "title": "CivicEvent",
  "type": "object"
}
