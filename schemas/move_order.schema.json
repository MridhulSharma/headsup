{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://headsup.local/schemas/move_order.schema.json",
  "$defs": {
    "LineString": {
      "additionalProperties": false,
      "description": "A road segment or a keep-clear corridor centre line.",
      "properties": {
        "type": {
          "const": "LineString",
          "default": "LineString",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "LineString",
      "type": "object"
    },
    "MultiLineString": {
      "additionalProperties": false,
      "description": "Several road segments, e.g. every approach to one intersection.",
      "properties": {
        "type": {
          "const": "MultiLineString",
          "default": "MultiLineString",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 2,
              "type": "array"
            },
            "minItems": 2,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiLineString",
      "type": "object"
    },
    "MultiPoint": {
      "additionalProperties": false,
      "description": "Several locations, e.g. the dark signals in one outage region.",
      "properties": {
        "type": {
          "const": "MultiPoint",
          "default": "MultiPoint",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPoint",
      "type": "object"
    },
    "MultiPolygon": {
      "additionalProperties": false,
      "description": "Several areas, e.g. two low-water crossings under one warning.",
      "properties": {
        "type": {
          "const": "MultiPolygon",
          "default": "MultiPolygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 2,
                "type": "array"
              },
              "minItems": 4,
              "type": "array"
            },
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPolygon",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "description": "A single location, e.g. a stream gauge or a stalled vehicle.",
      "properties": {
        "type": {
          "const": "Point",
          "default": "Point",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Point",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "description": "An area: the first ring is the exterior, the rest are holes.",
      "properties": {
        "type": {
          "const": "Polygon",
          "default": "Polygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 2,
              "type": "array"
            },
            "minItems": 4,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A verified responder asking vehicles out of an area.\n\n`token_fingerprint` is the SHA-256 of the responder token the liaison\nchecked; an order without one never reaches the compiler (attack A5).",
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:\\-]+$",
      "title": "Id",
      "type": "string"
    },
    "responder_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:\\-]+$",
      "title": "Responder Id",
      "type": "string"
    },
    "agency": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:\\-]+$",
      "title": "Agency",
      "type": "string"
    },
    "geometry": {
      "discriminator": {
        "mapping": {
          "LineString": "#/$defs/LineString",
          "MultiLineString": "#/$defs/MultiLineString",
          "MultiPoint": "#/$defs/MultiPoint",
          "MultiPolygon": "#/$defs/MultiPolygon",
          "Point": "#/$defs/Point",
          "Polygon": "#/$defs/Polygon"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Point"
        },
        {
          "$ref": "#/$defs/MultiPoint"
        },
        {
          "$ref": "#/$defs/LineString"
        },
        {
          "$ref": "#/$defs/MultiLineString"
        },
        {
          "$ref": "#/$defs/Polygon"
        },
        {
          "$ref": "#/$defs/MultiPolygon"
        }
      ],
      "title": "Geometry"
    },
    "vehicle_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:\\-]+$",
        "type": "string"
      },
      "title": "Vehicle Ids",
      "type": "array"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "token_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Token Fingerprint",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    },
    "signature": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature"
    }
  },
  "required": [
    "responder_id",
    "agency",
    "geometry",
    "token_fingerprint",
    "valid_until"
  ],
  "title": "MoveOrder",
  "type": "object"
}
